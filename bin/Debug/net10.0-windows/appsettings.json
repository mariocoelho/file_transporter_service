      {
        "Name": "SecondSource",
        "SourceFolder": "C:\\Concentrador\\Rx_Other",
        "MaxFilesPerBatch": 5,
        "ScanIntervalSeconds": 60
      }
    ]
  },
  "Serilog": {
    "MinimumLevel": "Debug",
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "C:\\Concentrador\\logs\\service.log",
